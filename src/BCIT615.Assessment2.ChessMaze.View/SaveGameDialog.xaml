<Window x:Class="BCIT615.Assessment2.ChessMaze.View.SaveGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BCIT615.Assessment2.ChessMaze.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Black"
        Title="Save Game" Height="200" Width="350">

    <Window.Resources>
      <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="button"
                      Background="Transparent"
                      BorderBrush="White"
                      BorderThickness="3">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>

              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Panel.ZIndex"
                          Value="2" />
                  <Setter TargetName="button"
                          Property="BorderBrush"
                          Value="Yellow" />
                  <Setter TargetName="button"
                          Property="BorderThickness"
                          Value="3,3,3,3" />
                  <Setter TargetName="button"
                          Property="Margin"
                          Value="-1.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border x:Name="textbox"
                      Background="Transparent"
                      BorderBrush="White"
                      BorderThickness="3">
              <ScrollViewer x:Name="PART_ContentHost" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
              </Border>

              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="textbox"
                          Property="BorderBrush"
                          Value="Yellow" />
                  <Setter TargetName="textbox"
                          Property="BorderThickness"
                          Value="3,3,3,3" />
                  <Setter TargetName="textbox"
                          Property="Margin"
                          Value="-1.5" />
                </Trigger>

                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="textbox"
                          Property="BorderBrush"
                          Value="Yellow" />
                  <Setter TargetName="textbox"
                          Property="BorderThickness"
                          Value="3,3,3,3" />
                  <Setter TargetName="textbox"
                          Property="Margin"
                          Value="-1.5" />
                </Trigger>

              </ControlTemplate.Triggers>

            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Window.Resources>


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="1.5*" />
      <RowDefinition Height="1.5*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="DialogMessageText"
               Text="Enter a name for your save" 
               HorizontalAlignment="Center"
               FontFamily="Consolas"
               FontWeight="Semibold"
               FontSize="18" 
               Foreground="White"
               VerticalAlignment="Center" />

    <TextBox x:Name="SaveGameNameTextBox" 
             Grid.Row="1" 
             FontFamily="Consolas"
             FontWeight="Semibold"
             FontSize="18"
             VerticalContentAlignment="Center"
             TextAlignment="Center"
             Margin="10,0,10,0"/>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button Content="Confirm" 
              FontFamily="Consolas"
              FontWeight="Semibold"
              FontSize="18"
              Margin="10,10,10,10" 
              Click="ConfirmSave_Click" />

      <Button Grid.Column="1"
              Content="Cancel" 
              FontFamily="Consolas"
              FontWeight="Semibold"
              FontSize="18"
              Margin="10,10,10,10" 
              Click="CancelSave_Click"/>

    </Grid>
  </Grid>
</Window>
