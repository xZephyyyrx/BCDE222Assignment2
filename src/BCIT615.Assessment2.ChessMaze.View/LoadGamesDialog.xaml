<Window x:Class="BCIT615.Assessment2.ChessMaze.View.LoadGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BCIT615.Assessment2.ChessMaze.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Black"
        Title="Load Game" Height="500" Width="400">

  <Window.Resources>
      <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="button"
                      Background="Transparent"
                      BorderBrush="White"
                      BorderThickness="3">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>

              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Panel.ZIndex"
                          Value="2" />
                  <Setter TargetName="button"
                          Property="BorderBrush"
                          Value="Yellow" />
                  <Setter TargetName="button"
                          Property="BorderThickness"
                          Value="3,3,3,3" />
                  <Setter TargetName="button"
                          Property="Margin"
                          Value="-1.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Window.Resources>


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="7.5*" />
      <RowDefinition Height="1.5*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="DialogMessageText"
               Text="Select a game to load"
               HorizontalAlignment="Center"
               FontFamily="Consolas"
               FontWeight="Semibold"
               FontSize="18"
               Foreground="White"
               VerticalAlignment="Center" />

    <ListBox x:Name="SavedGameListBox"
             SelectionMode="Single"
             HorizontalContentAlignment="Stretch"
             Grid.Row="1"
             FontFamily="Consolas"
             FontWeight="Semibold"
             FontSize="18"
             Foreground="White" 
             Background="Transparent" 
             Margin="10,0,10,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding SaveTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>


    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button Content="Load"
              FontFamily="Consolas"
              FontWeight="Semibold"
              FontSize="18"
              Margin="10,10,10,10" 
              Click="ConfirmLoad_Click" />

      <Button Grid.Column="1"
              Content="Cancel"
              FontFamily="Consolas"
              FontWeight="Semibold"
              FontSize="18"
              Margin="10,10,10,10" 
              Click="CancelLoad_Click" />


    </Grid>
  </Grid>
</Window>

